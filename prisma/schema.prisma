generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ АУТЕНТИФИКАЦИЯ И ПОЛЬЗОВАТЕЛИ ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("worker") // admin, manager, engineer, worker
  departmentId  String?
  brigadeId     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  department    Department?  @relation(fields: [departmentId], references: [id])
  brigade       Brigade?     @relation(fields: [brigadeId], references: [id])
  auditLogs     AuditLog[]
  createdRequests UnplannedRequest[] @relation("RequestAuthor")
  assignedRequests UnplannedRequest[] @relation("RequestAssignee")
  foremanBrigades   Brigade[]  @relation("BrigadeForeman")
  assignedShiftTasks ShiftTask[] @relation("ShiftTaskAssigner")
  issuedPermits     WorkPermit[] @relation("PermitIssuer")

  @@index([departmentId])
  @@index([brigadeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String   // Equipment, SparePart, etc.
  entityId  String?
  details   String?  // JSON string with changes
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ============ ОРГСТРУКТУРА И ПЕРСОНАЛ ============

model Department {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  parentId    String?
  description String?
  headName    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  users       User[]
  brigades    Brigade[]
  equipment   Equipment[]

  @@index([parentId])
}

model Brigade {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  departmentId  String
  foremanId     String?  // бригадир
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department    Department @relation(fields: [departmentId], references: [id])
  foreman       User?      @relation("BrigadeForeman", fields: [foremanId], references: [id])
  members       User[]
  shiftTasks    ShiftTask[]
  workPermits   WorkPermit[]
  maintenanceTasks MaintenanceTask[]
  unplannedRequests  UnplannedRequest[]

  @@index([departmentId])
}

model ShiftTask {
  id          String   @id @default(cuid())
  brigadeId   String
  date        String   // YYYY-MM-DD
  shift       String   @default("day") // day, night
  description String
  status      String   @default("planned") // planned, in_progress, completed, cancelled
  assignedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brigade     Brigade  @relation(fields: [brigadeId], references: [id])
  assigner    User?    @relation("ShiftTaskAssigner", fields: [assignedBy], references: [id])

  @@index([brigadeId])
  @@index([date])
}

model WorkPermit {
  id              String   @id @default(cuid())
  number          String   @unique
  brigadeId       String
  equipmentId     String?
  description     String
  workType        String   // repair, maintenance, installation, etc.
  riskLevel       String   @default("normal") // low, normal, high, extreme
  startDate       String
  endDate         String
  responsibleName String
  status          String   @default("draft") // draft, active, completed, cancelled
  issuedBy        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brigade         Brigade  @relation(fields: [brigadeId], references: [id])
  equipment       Equipment? @relation(fields: [equipmentId], references: [id])
  issuer          User?    @relation("PermitIssuer", fields: [issuedBy], references: [id])

  @@index([brigadeId])
  @@index([status])
}

// ============ ОБОРУДОВАНИЕ ============

model Equipment {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique   // инвентарный номер
  parentId        String?
  departmentId    String?
  equipmentTypeId String?
  location        String?
  manufacturer    String?
  model           String?
  serialNumber    String?
  commissionDate  String?
  status          String   @default("active") // active, under_repair, decommissioned
  criticality     String   @default("medium") // low, medium, high, critical
  description     String?
  specifications  String?  // JSON: технические характеристики
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // --- Extended equipment attributes (Excel 93 fields) ---
  inventoryNumber       String?   // Инвентарный номер ОС (11 digits)
  quantity              Float?    // Количество
  unit                  String?   // ЕИ: м, шт, км
  drawing               String?   // Чертёж
  equipmentClass        String?   // Класс
  topazNumber           String?   // Номер ТОПАЗ
  sapNumber             Int?      // Номер SAP TORO
  abcdCode              String?   // Код ABCD: A/B/C/D
  costCenter            String?   // МВЗ
  manufactureDate       String?   // Дата выпуска YYYY-MM-DD
  decommissionDate      String?   // Дата списания
  processImportance     String?   // Важность для технологического процесса
  isKey                 Boolean   @default(false) // Ключевое
  isTest                Boolean   @default(false) // Испытательное
  hasReserve            Boolean   @default(false) // Наличие резерва
  parentEquipmentSap    Int?      // Вышестоящая ЕО (SAP номер)

  // JSON fields for grouped attributes
  locationData          String?   // JSON: Group 2 — Местоположение (17 fields)
  responsibilityData    String?   // JSON: Group 3 — Ответственность (5 fields)
  maintenanceData       String?   // JSON: Group 3 — ТО и ремонты (26 fields)
  verificationData      String?   // JSON: Group 4 — Поверка (2 fields)
  safetyData            String?   // JSON: Group 5 — Промышленная безопасность (14 fields)
  supervisionData       String?   // JSON: Group 1 — Надзор (6 fields)

  parent          Equipment?       @relation("EquipHierarchy", fields: [parentId], references: [id])
  children        Equipment[]      @relation("EquipHierarchy")
  department      Department?      @relation(fields: [departmentId], references: [id])
  equipmentType   EquipmentType?   @relation(fields: [equipmentTypeId], references: [id])
  maintenancePlan MaintenancePlan[]
  workPermits     WorkPermit[]
  sparePartMovements SparePartMovement[]
  unplannedRequests UnplannedRequest[]
  measuredParameters MeasuredParameter[]

  @@index([parentId])
  @@index([departmentId])
  @@index([equipmentTypeId])
  @@index([status])
}

model MeasuredParameter {
  id                String   @id @default(cuid())
  equipmentId       String
  name              String
  unitOkei          String?
  unitSymbol        String?
  refValue          Float?
  toleranceMin      Float?
  toleranceMax      Float?
  description       String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  equipment         Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  records           MeasurementRecord[]

  @@index([equipmentId])
}

model MeasurementRecord {
  id                String   @id @default(cuid())
  parameterId       String
  measuredValue     Float
  measuredDate      String
  operatorName      String
  notes             String?
  createdAt         DateTime @default(now())

  parameter         MeasuredParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId])
  @@index([measuredDate])
}

model EquipmentType {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  parentId    String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      EquipmentType?  @relation("TypeHierarchy", fields: [parentId], references: [id])
  children    EquipmentType[] @relation("TypeHierarchy")
  equipment   Equipment[]

  @@index([parentId])
}

// ============ ЗАПАСНЫЕ ЧАСТИ ============

model SparePart {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique   // артикул
  categoryId  String?
  unit        String   @default("шт") // единица измерения
  minStock    Int      @default(0)   // минимальный остаток
  currentStock Int     @default(0)  // текущий остаток
  price       Float?
  description String?
  specifications String? // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    SparePartCategory?    @relation(fields: [categoryId], references: [id])
  movements   SparePartMovement[]

  @@index([categoryId])
}

model SparePartCategory {
  id          String          @id @default(cuid())
  name        String
  code        String          @unique
  parentId    String?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  parent      SparePartCategory?   @relation("SpareCatHierarchy", fields: [parentId], references: [id])
  children    SparePartCategory[]  @relation("SpareCatHierarchy")
  parts       SparePart[]

  @@index([parentId])
}

model SparePartMovement {
  id           String   @id @default(cuid())
  sparePartId  String
  equipmentId  String?
  type         String   // receipt, issue, transfer, write_off
  quantity     Int
  reason       String?
  documentNo   String?
  performedBy  String?
  createdAt    DateTime @default(now())

  sparePart    SparePart @relation(fields: [sparePartId], references: [id])
  equipment    Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([sparePartId])
  @@index([equipmentId])
}

// ============ ПЛАНИРОВАНИЕ ППР ============

model MaintenancePlan {
  id              String   @id @default(cuid())
  equipmentId     String   @unique
  planName        String
  lastMaintenance String?
  nextMaintenance String
  intervalDays    Int
  description     String?
  status          String   @default("active") // active, paused, completed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  equipment       Equipment @relation(fields: [equipmentId], references: [id])
  tasks           MaintenanceTask[]

  @@index([equipmentId])
  @@index([status])
}

model MaintenanceTask {
  id              String   @id @default(cuid())
  planId          String
  scheduledDate   String
  description     String
  brigadeId       String?
  status          String   @default("planned") // planned, assigned, in_progress, completed, overdue
  completedAt     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan            MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  brigade         Brigade?        @relation(fields: [brigadeId], references: [id])

  @@index([planId])
  @@index([scheduledDate])
  @@index([status])
}

// ============ НЕПЛАНОВЫЕ ЗАЯВКИ ============

model UnplannedRequest {
  id            String   @id @default(cuid())
  number        String   @unique
  equipmentId   String?
  title         String
  description   String
  priority      String   @default("medium") // low, medium, high, critical
  status        String   @default("new") // new, assigned, in_progress, completed, cancelled
  requestedBy   String   // author userId
  assignedTo    String?  // assignee userId
  brigadeId     String?
  completedAt   String?
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  equipment     Equipment?      @relation(fields: [equipmentId], references: [id])
  author        User            @relation("RequestAuthor", fields: [requestedBy], references: [id])
  assignee      User?           @relation("RequestAssignee", fields: [assignedTo], references: [id])
  brigade       Brigade?        @relation(fields: [brigadeId], references: [id])

  @@index([equipmentId])
  @@index([requestedBy])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
}
